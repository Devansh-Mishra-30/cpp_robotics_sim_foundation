<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse_world">

    <!-- ================================================================ -->
    <!-- Gazebo systems                                                    -->
    <!-- ================================================================ -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- ================================================================ -->
    <!-- Lighting and scene                                                -->
    <!-- ================================================================ -->

    <scene>
      <ambient>0.45 0.45 0.50 1</ambient>
      <background>0.12 0.15 0.20 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="warehouse_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 14 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.25 -0.85</direction>
    </light>

    <light name="warehouse_fill_light" type="point">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.65 0.72 0.90 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.4</constant>
        <linear>0.03</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- ================================================================ -->
    <!-- Main warehouse floor: 20 m x 16 m                                -->
    <!-- ================================================================ -->

    <model name="warehouse_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>20 16 0.10</size>
            </box>
          </geometry>
        </collision>

        <visual name="floor_visual">
          <geometry>
            <box>
              <size>20 16 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.34 0.38 1</ambient>
            <diffuse>0.40 0.42 0.46 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Perimeter walls                                                   -->
    <!-- ================================================================ -->

    <model name="north_wall">
      <static>true</static>
      <pose>0 8 1.25 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>20.4 0.25 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.4 0.25 2.5</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.74 1</ambient>
            <diffuse>0.78 0.80 0.84 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -8 1.25 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>20.4 0.25 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20.4 0.25 2.5</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.74 1</ambient>
            <diffuse>0.78 0.80 0.84 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>10 0 1.25 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.25 16.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 16.0 2.5</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.74 1</ambient>
            <diffuse>0.78 0.80 0.84 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-10 0 1.25 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.25 16.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 16.0 2.5</size></box></geometry>
          <material>
            <ambient>0.68 0.70 0.74 1</ambient>
            <diffuse>0.78 0.80 0.84 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Rack group A: left side                                           -->
    <!-- ================================================================ -->

    <model name="rack_a_upper">
      <static>true</static>
      <pose>-5.8 3.5 1.10 0 0 0</pose>
      <link name="rack_link">
        <collision name="collision">
          <geometry><box><size>1.2 5.0 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 5.0 2.2</size></box></geometry>
          <material>
            <ambient>0.10 0.25 0.62 1</ambient>
            <diffuse>0.14 0.34 0.80 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="rack_a_lower">
      <static>true</static>
      <pose>-5.8 -3.5 1.10 0 0 0</pose>
      <link name="rack_link">
        <collision name="collision">
          <geometry><box><size>1.2 5.0 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 5.0 2.2</size></box></geometry>
          <material>
            <ambient>0.10 0.25 0.62 1</ambient>
            <diffuse>0.14 0.34 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Rack group B: center-left                                         -->
    <!-- ================================================================ -->

    <model name="rack_b_upper">
      <static>true</static>
      <pose>-2.8 3.5 1.10 0 0 0</pose>
      <link name="rack_link">
        <collision name="collision">
          <geometry><box><size>1.2 5.0 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 5.0 2.2</size></box></geometry>
          <material>
            <ambient>0.85 0.42 0.05 1</ambient>
            <diffuse>0.95 0.52 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rack_b_lower">
      <static>true</static>
      <pose>-2.8 -3.5 1.10 0 0 0</pose>
      <link name="rack_link">
        <collision name="collision">
          <geometry><box><size>1.2 5.0 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 5.0 2.2</size></box></geometry>
          <material>
            <ambient>0.85 0.42 0.05 1</ambient>
            <diffuse>0.95 0.52 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Rack group C: right side                                          -->
    <!-- ================================================================ -->

    <model name="rack_c_upper">
      <static>true</static>
      <pose>3.5 3.5 1.10 0 0 0</pose>
      <link name="rack_link">
        <collision name="collision">
          <geometry><box><size>1.4 5.0 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 5.0 2.2</size></box></geometry>
          <material>
            <ambient>0.10 0.55 0.36 1</ambient>
            <diffuse>0.12 0.72 0.44 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rack_c_lower">
      <static>true</static>
      <pose>3.5 -3.5 1.10 0 0 0</pose>
      <link name="rack_link">
        <collision name="collision">
          <geometry><box><size>1.4 5.0 2.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 5.0 2.2</size></box></geometry>
          <material>
            <ambient>0.10 0.55 0.36 1</ambient>
            <diffuse>0.12 0.72 0.44 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Dead-end test structure                                           -->
    <!-- ================================================================ -->

    <model name="dead_end_left_wall">
      <static>true</static>
      <pose>6.2 3.8 0.9 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.25 4.5 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 4.5 1.8</size></box></geometry>
          <material>
            <ambient>0.55 0.15 0.15 1</ambient>
            <diffuse>0.78 0.20 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="dead_end_right_wall">
      <static>true</static>
      <pose>8.4 3.8 0.9 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>0.25 4.5 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 4.5 1.8</size></box></geometry>
          <material>
            <ambient>0.55 0.15 0.15 1</ambient>
            <diffuse>0.78 0.20 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="dead_end_back_wall">
      <static>true</static>
      <pose>7.3 6.0 0.9 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>2.45 0.25 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.45 0.25 1.8</size></box></geometry>
          <material>
            <ambient>0.55 0.15 0.15 1</ambient>
            <diffuse>0.78 0.20 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Loading dock and packing areas                                    -->
    <!-- ================================================================ -->

    <model name="loading_dock_platform">
      <static>true</static>
      <pose>7.3 -5.7 0.18 0 0 0</pose>
      <link name="platform_link">
        <collision name="collision">
          <geometry><box><size>4.0 2.6 0.35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 2.6 0.35</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.48 0.48 0.52 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="packing_station">
      <static>true</static>
      <pose>7.0 -1.6 0.55 0 0 0</pose>
      <link name="station_link">
        <collision name="collision">
          <geometry><box><size>2.5 1.2 1.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.5 1.2 1.1</size></box></geometry>
          <material>
            <ambient>0.55 0.16 0.58 1</ambient>
            <diffuse>0.72 0.22 0.76 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Charging station                                                  -->
    <!-- ================================================================ -->

    <model name="charging_station">
      <static>true</static>
      <pose>-8.7 -6.7 0.6 0 0 0</pose>
      <link name="charger_link">
        <collision name="collision">
          <geometry><box><size>0.45 1.5 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 1.5 1.2</size></box></geometry>
          <material>
            <ambient>0.05 0.62 0.72 1</ambient>
            <diffuse>0.08 0.82 0.92 1</diffuse>
            <emissive>0.02 0.12 0.15 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Floor markings: visual only                                       -->
    <!-- ================================================================ -->

    <model name="spawn_zone">
      <static>true</static>
      <pose>0 0 0.061 0 0 0</pose>
      <link name="marking_link">
        <visual name="visual">
          <geometry><box><size>2.0 2.0 0.012</size></box></geometry>
          <material>
            <ambient>0.05 0.55 0.85 1</ambient>
            <diffuse>0.05 0.65 0.95 1</diffuse>
            <emissive>0.01 0.05 0.08 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="main_cross_aisle_marking">
      <static>true</static>
      <pose>-1.0 0 0.062 0 0 0</pose>
      <link name="marking_link">
        <visual name="visual">
          <geometry><box><size>15.5 0.08 0.014</size></box></geometry>
          <material>
            <ambient>0.95 0.76 0.08 1</ambient>
            <diffuse>1.0 0.82 0.10 1</diffuse>
            <emissive>0.12 0.09 0.01 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="loading_zone_marking">
      <static>true</static>
      <pose>7.3 -7.0 0.062 0 0 0</pose>
      <link name="marking_link">
        <visual name="visual">
          <geometry><box><size>4.0 0.10 0.014</size></box></geometry>
          <material>
            <ambient>0.95 0.76 0.08 1</ambient>
            <diffuse>1.0 0.82 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Asymmetric landmarks for AMCL                                     -->
    <!-- ================================================================ -->

    <model name="landmark_column_northwest">
      <static>true</static>
      <pose>-8.3 6.1 1.0 0 0 0</pose>
      <link name="column_link">
        <collision name="collision">
          <geometry><cylinder><radius>0.42</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.42</radius><length>2.0</length></cylinder></geometry>
          <material>
            <ambient>0.90 0.12 0.58 1</ambient>
            <diffuse>1.0 0.18 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="landmark_column_southeast">
      <static>true</static>
      <pose>8.5 -3.5 0.8 0 0 0</pose>
      <link name="column_link">
        <collision name="collision">
          <geometry><cylinder><radius>0.32</radius><length>1.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.32</radius><length>1.6</length></cylinder></geometry>
          <material>
            <ambient>0.92 0.78 0.08 1</ambient>
            <diffuse>1.0 0.90 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
