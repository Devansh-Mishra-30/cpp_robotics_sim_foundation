<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="hospital_world">

    <!-- ================================================================ -->
    <!-- Gazebo systems                                                    -->
    <!-- ================================================================ -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- ================================================================ -->
    <!-- Scene and lighting                                                -->
    <!-- ================================================================ -->

    <scene>
      <ambient>0.72 0.74 0.78 1</ambient>
      <background>0.86 0.90 0.96 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="hospital_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.98 0.98 1.0 1</diffuse>
      <specular>0.18 0.18 0.20 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.15 -0.92</direction>
    </light>

    <light name="hospital_fill_light" type="point">
      <pose>0 0 7 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.85 0.90 1.0 1</diffuse>
      <specular>0.08 0.08 0.10 1</specular>
      <attenuation>
        <range>35</range>
        <constant>0.35</constant>
        <linear>0.025</linear>
        <quadratic>0.0015</quadratic>
      </attenuation>
    </light>

    <!-- ================================================================ -->
    <!-- Hospital floor: 22 m x 18 m                                      -->
    <!-- ================================================================ -->

    <model name="hospital_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>22 18 0.10</size>
            </box>
          </geometry>
        </collision>

        <visual name="floor_visual">
          <geometry>
            <box>
              <size>22 18 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.90 0.93 0.96 1</diffuse>
            <specular>0.16 0.16 0.18 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- Outer walls                                                       -->
    <!-- ================================================================ -->

    <model name="north_outer_wall">
      <static>true</static>
      <pose>0 9 1.35 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision">
          <geometry><box><size>22.4 0.25 2.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>22.4 0.25 2.7</size></box></geometry>
          <material>
            <ambient>0.86 0.88 0.92 1</ambient>
            <diffuse>0.96 0.97 0.99 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

